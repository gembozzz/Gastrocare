# ============================================
# GastroCare Frontend — Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi nilainya.
# Semua variabel HARUS diawali dengan VITE_ agar
# bisa diakses via import.meta.env di Vite.

# Backend API base URL (tanpa trailing slash)
VITE_API_URL=http://localhost:3001/api

# Nama aplikasi
VITE_APP_NAME=GastroCare

# Environment mode (development | production)
VITE_APP_ENV=development
