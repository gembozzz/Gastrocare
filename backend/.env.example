# ============================================
# GastroCare Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/gastrocare_db"

# JWT Authentication
JWT_SECRET=your-super-secret-key-min-32-chars-change-this
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: Email Service (for sending results to patients)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# AI Model API (FastAPI — Prediksi Penyakit Lambung)
AI_API_URL=http://localhost:8000
